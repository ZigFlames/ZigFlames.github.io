{
  "version": "20261011i",
  "notes": "Loop Lab data. Edit wording, order and presets here; the app reads this file (no code changes needed). 'words' = wording variants (Remix rolls between them; the first one is the default). No artist names anywhere: describe the sound.",
  "targets": {
    "grok": {
      "label": "Grok",
      "positiveLabel": "Grok Imagine prompt",
      "negativeLabel": "Avoid line (append to the prompt)",
      "positiveSoftMax": 1000,
      "negativeField": false,
      "negativePrefix": "Avoid: ",
      "template": "Visual: {visual}. AUDIO: music only, speech: none, sound effects: none. Music: {positive}.",
      "visual": "locked-off close-up of an Akai MPC with glowing pads beside a turntable and crates of dusty records in a 90s beat studio, no people",
      "maxClipSeconds": 15,
      "hint": "Grok has no standalone music model: music comes from Grok Imagine video audio (clips up to ~15 s). Paste the prompt into grok.com/imagine, add the Avoid line at the end (Grok follows 'avoid' wording loosely), then rip the audio from the clip.",
      "sketchHint": "Grok Imagine can't take your sketch audio as input. Describe the sketch in the Idea box, or use the Suno target (Upload → Cover / Extend) to finish a real sketch."
    },
    "suno": {
      "label": "Suno",
      "positiveLabel": "Style of Music",
      "negativeLabel": "Exclude Styles",
      "structureLabel": "Lyrics box (structure tags)",
      "positiveMax": 1000,
      "negativeMax": 200,
      "negativeField": true,
      "negativePrefix": "",
      "hint": "Suno Custom mode: paste Positive into Style of Music (1,000 chars on v4.5 to v5.5) and Negative into Exclude Styles (200 chars). Turn on Instrumental for loops. No artist names: Suno rejects them.",
      "sketchHint": "Finish a sketch: Create → Upload audio (your sketch) → Cover or Extend, paste Style + Exclude Styles, and paste the structure tags into the Lyrics box."
    },
    "generic": {
      "label": "Generic",
      "positiveLabel": "Prompt",
      "negativeLabel": "Negative prompt",
      "negativeField": true,
      "negativePrefix": "",
      "hint": "Any music generator: paste Positive into the prompt field and Negative into its negative / exclude field (or append it as 'Avoid: …').",
      "sketchHint": "If your generator accepts audio input, upload the sketch and use these prompts to extend or cover it."
    }
  },
  "order": {
    "loop": [
      "idea",
      "loopType",
      "genre",
      "tempoKey",
      "instruments",
