    ]
  },
  "loopRules": [
    "seamless {bars}-bar loop",
    "loop point lands exactly on the downbeat",
    "constant tempo",
    "starts and ends on beat one",
    "instrumental"
  ],
  "sketchRules": [
    "keep the original motif and melody",
    "keep the same key and BPM",
    "same groove and sound palette as the sketch",
    "full song with a clear arrangement build-up"
  ],
  "arrangement": [
    "sparse intro with the main motif",
    "drums and bass enter at the verse",
    "hook opens up with more layers",
    "bridge breaks down to a stripped motif",
    "last hook is the biggest",
    "outro strips back to the motif"
  ],
  "structure": [
    {
      "tag": "Intro",
      "hint": "{lead} motif alone"
    },
    {
      "tag": "Verse",
      "hint": "drums and bass enter, motif continues"
    },
    {
      "tag": "Hook",
      "hint": "full arrangement, {color} layered in"
    },
    {
      "tag": "Verse",
      "hint": "variation, lighter drums"
    },
    {
      "tag": "Hook",
      "hint": "full arrangement"
    },
    {
      "tag": "Bridge",
      "hint": "breakdown, filtered {lead}, no drums"
    },
    {
      "tag": "Hook",
      "hint": "biggest hook, every layer in"
    },
    {
      "tag": "Outro",
      "hint": "{lead} motif alone, clean ending"
    }
  ],
